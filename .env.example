# Tasks API configuration.
# Copy this file to .env and adjust the values. Never commit the real .env.

# SQLAlchemy URL of the database.
TASKS_DATABASE_URL=sqlite:///./tasks.db

# Minimum log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
TASKS_LOG_LEVEL=INFO

# Bind address and listening port of the HTTP server.
TASKS_HOST=127.0.0.1
TASKS_PORT=8000
